# ── Database (SQLAlchemy + Alembic, direct Postgres connection) ──────────
# Points at the local Supabase CLI stack's Postgres (`supabase start` —
# see supabase/config.toml). host.docker.internal lets the backend
# container reach it on the host. Switch this to Supabase's own Postgres
# connection string (Project Settings > Database > direct connection, not
# the pooler) once ready to run against the cloud project — same schema,
# same Alembic migrations, just a different URL. Table access does NOT go
# through Supabase's Data API/PostgREST — that layer is disabled/unused.
DATABASE_URL=postgresql+psycopg://postgres:postgres@host.docker.internal:54322/postgres

# ── Supabase (local CLI stack by default — Auth + Storage) ───────────────
# Run `supabase start` and copy API_URL / ANON_KEY / SERVICE_ROLE_KEY from
# its output. User session tokens are verified via JWKS (SUPABASE_URL +
# /auth/v1/.well-known/jwks.json, see app/core/auth.py) — no shared secret
# needed, works the same for local and cloud.
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Claude (Anthropic) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# ── Voyage AI (embeddings) ───────────────────────────────────────────────
# voyage-4-large outputs 1024-dim vectors -- must match document_chunks.embedding's
# VECTOR(N) in the schema (see backend/app/models/document.py EMBEDDING_DIM).
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4-large

# ── App login ────────────────────────────────────────────────────────────
# Google login works two ways during development:
#   - Email/Password (frontend Login page) — no external setup, always
#     available against the local Supabase CLI stack.
#   - Google OAuth — configured directly in the Supabase dashboard
#     (Authentication > Providers > Google) with its own Google Cloud
#     OAuth client. There is no corresponding variable here — Supabase
#     holds that client's credentials, not this backend.

# ── Gmail send (separate OAuth client — see spec2.md section 26) ─────────
# This is a DIFFERENT Google OAuth client than the login one above, scoped
# to gmail.send only. Do not reuse the login client's credentials here.
# GMAIL_REDIRECT_URI must exactly match the Authorized redirect URI
# configured on that Google Cloud OAuth client (e.g.
# http://localhost:8000/api/gmail/callback).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
# Fernet key encrypting gmail_credentials.encrypted_refresh_token at rest.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GMAIL_TOKEN_ENCRYPTION_KEY=

# mock: logs a fake send, never touches a real mail provider (default).
# gmail: sends for real via the Gmail API, using a per-user credential
# connected on the Settings page (requires the four GMAIL_* vars above).
EMAIL_MODE=mock

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ── CWA (中央氣象署開放資料平台，天氣查詢 MCP 工具) ─────────────────
# Register a free Authorization key at https://opendata.cwa.gov.tw/user/authkey
CWA_API_KEY=

# GIS 案址查詢工具（check_site_location）的地理編碼用 OpenStreetMap
# Nominatim（見 backend/app/services/geo_service.py）——免申請、免金鑰，
# 這裡不需要對應的環境變數。TGOS 的門牌位置比對服務評估過，但僅開放政府
# 機關/公營事業/學術及法人團體/公司行號申請，個人無法申請，故未採用。

# ── Frontend (Vite) ──────────────────────────────────────────────────────
# Must be prefixed VITE_ to be exposed to the browser bundle. Safe to be
# public: these are the anon key + URLs, never the service role key.
# Browser-facing, so plain localhost (not host.docker.internal) is correct
# here — this runs in the user's browser, not inside a container.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=
VITE_BACKEND_URL=http://localhost:8000
